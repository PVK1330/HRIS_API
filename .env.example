# =============================================================================
# HRIS API — environment template (copy to `.env` and fill values)
# =============================================================================

# --- Core (required for this project) ----------------------------------------
NODE_ENV=development
PORT=5000
DB_USER=postgres
DB_PASS=your_postgres_password
DB_NAME=hris_central
DB_HOST=localhost
DB_PORT=5432
# Set to true for cloud-hosted Postgres that requires SSL
DB_SSL=false
# Must be ≥64 hex chars. Generate: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret
# Access token lifetime (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d
# 32-byte hex key for AES field encryption. Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_char_hex_key
# Comma-separated exact origins + tenant subdomains (see below)
CORS_ORIGINS=http://localhost:5173
# Allow http://your-tenant.localhost:5173 (default true in dev)
CORS_ALLOW_SUBDOMAIN_ORIGINS=true
CORS_LOCALHOST_PORTS=5173,4173
# Production: allow https://*.yourdomain.com
# CORS_SUBDOMAIN_HOST_SUFFIX=hris.yourcompany.com
# Dev only — allow every origin (not for production)
# CORS_ALLOW_ALL=true

# --- Stripe (required for billing features) ----------------------------------
# Use sk_test_... in development, sk_live_... in production
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
# Publishable key (safe to expose on frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
# Signing secret from Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# --- SuperAdmin seed (used only by `npm run seed:superadmin`) ----------------
SEED_SUPERADMIN_EMAIL=superadmin@yourdomain.com
# Use a strong password — min 12 chars, mix of upper/lower/numbers/symbols
SEED_SUPERADMIN_PASSWORD=replace_with_strong_password
SEED_SUPERADMIN_NAME=Root SuperAdmin

# --- Gmail SMTP (alternative to MAIL_HOST/MAIL_USER above) ------------------
# Gmail address used to send system emails
EMAIL_USER=your_gmail@gmail.com
# Gmail App Password (NOT your account password). Create at: myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_gmail_app_password

# --- Google OAuth (Calendar & Meet — optional) --------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/meetings/google-oauth/callback

# --- Optional ----------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
EXIT_TASK_DUE_DAYS=7
# Local dev only — set to true to bypass rate limiting during development.
# NEVER set this in staging or production.
# DISABLE_RATE_LIMIT=true

# --- Rate limiting -----------------------------------------------------------
# All values below are optional; the defaults shown are used when unset.
# (Previously these env vars were read under the wrong names and silently
#  ignored — they are now actually applied.)
#
# General API limiter (every request): window length + max requests per window.
# RATE_LIMIT_WINDOW_MS=900000          # 15 minutes
# RATE_LIMIT_MAX=100
# Auth endpoints (login) — only FAILED requests count toward this max.
# AUTH_RATE_LIMIT_MAX=10
# OTP verification (verify-otp + reset-password) — EVERY attempt counts.
# OTP_RATE_LIMIT_MAX=10
# Public tenant self-registration (its own longer window).
# REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000   # 1 hour
# REGISTRATION_RATE_LIMIT_MAX=5
# Token refresh (uses the general window above).
# REFRESH_RATE_LIMIT_MAX=60
# Candidate onboarding portal (offer / sign / documents).
# CANDIDATE_RATE_LIMIT_WINDOW_MS=900000       # 15 minutes
# CANDIDATE_RATE_LIMIT_MAX=150

# Local debugging only — include error stack traces in HTTP error responses.
# Default OFF. Ignored in production (NODE_ENV=production), where traces are
# only ever logged server-side and never returned to clients.
# EXPOSE_STACK=true

# Log verbosity. Defaults to "debug" in development, "info" in production.
# Valid Winston levels: error warn info http verbose debug silly
# LOG_LEVEL=debug

# Absolute path to the logo PNG used in GDPR PDF exports.
# Defaults to src/assets/HRIS_Logo.png bundled with the API.
# LOGO_PATH=/etc/hris/branding/logo.png

# --- Employee welcome email & branding ---------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=hr@company.com
MAIL_PASS=your_app_password
MAIL_FROM="HRIS System <hr@company.com>"
EMAIL_FROM_NAME=HRIS System
# In development, failed SMTP is logged as mock unless MAIL_FORCE_SEND=true
# MAIL_FORCE_SEND=true
# Use a real inbox or Mailtrap; @demo.com has no MX and will not receive mail
PORTAL_URL=https://hris.company.com
COMPANY_NAME=HRIS
# Comma-separated shared inbox for onboarding (ID proof + resume on Accepted)
ONBOARDING_HR_EMAIL=hr@company.com

# --- Visa compliance & document storage --------------------------------------
HR_ADMIN_EMAIL=hr@company.com
ALERT_DAYS_AHEAD=60
STORAGE_TYPE=local
# FRONTEND_URL=http://localhost:5173
DISABLE_VISA_EXPIRY_CRON=false

# --- Uploads -----------------------------------------------------------------
# UPLOAD_DIR=./src/uploads
