# =============================================================================
# HRIS API — environment template (copy to `.env` and fill values)
# =============================================================================

# --- Core (required for this project) ----------------------------------------
NODE_ENV=development
PORT=5000
DB_USER=
DB_PASS=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173

# --- Optional ----------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# --- Employee welcome email & branding ---------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=hr@company.com
MAIL_PASS=your_app_password
MAIL_FROM="HRIS System <hr@company.com>"
EMAIL_FROM_NAME=HRIS System
PORTAL_URL=https://portal.company.com
COMPANY_NAME=YourCompany

# --- Visa compliance & document storage --------------------------------------
HR_ADMIN_EMAIL=hr@company.com
ALERT_DAYS_AHEAD=60
STORAGE_TYPE=local
# FRONTEND_URL=http://localhost:5173
DISABLE_VISA_EXPIRY_CRON=false

# --- Uploads -----------------------------------------------------------------
# UPLOAD_DIR=./src/uploads
