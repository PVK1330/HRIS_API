# =============================================================================
# HRIS API — environment template (copy to `.env` and fill values)
# =============================================================================

# --- Core (required for this project) ----------------------------------------
NODE_ENV=development
PORT=5000
DB_USER=
DB_PASS=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
# Comma-separated exact origins + tenant subdomains (see below)
CORS_ORIGINS=http://localhost:5173
# Allow http://your-tenant.localhost:5173 (default true in dev)
CORS_ALLOW_SUBDOMAIN_ORIGINS=true
CORS_LOCALHOST_PORTS=5173,4173
# Production: allow https://*.yourdomain.com
# CORS_SUBDOMAIN_HOST_SUFFIX=hris.yourcompany.com
# Dev only — allow every origin (not for production)
# CORS_ALLOW_ALL=true

# --- Optional ----------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
EXIT_TASK_DUE_DAYS=7

# --- Employee welcome email & branding ---------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=hr@company.com
MAIL_PASS=your_app_password
MAIL_FROM="HRIS System <hr@company.com>"
EMAIL_FROM_NAME=HRIS System
# In development, failed SMTP is logged as mock unless MAIL_FORCE_SEND=true
# MAIL_FORCE_SEND=true
# Use a real inbox or Mailtrap; @demo.com has no MX and will not receive mail
PORTAL_URL=https://hris.company.com
COMPANY_NAME=HRIS
# Comma-separated shared inbox for onboarding (ID proof + resume on Accepted)
ONBOARDING_HR_EMAIL=hr@company.com

# --- Visa compliance & document storage --------------------------------------
HR_ADMIN_EMAIL=hr@company.com
ALERT_DAYS_AHEAD=60
STORAGE_TYPE=local
# FRONTEND_URL=http://localhost:5173
DISABLE_VISA_EXPIRY_CRON=false

# --- Uploads -----------------------------------------------------------------
# UPLOAD_DIR=./src/uploads
