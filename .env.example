# Server
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DB_USER=postgres
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=hris_master
DB_HOST=127.0.0.1
DB_PORT=5432

# JWT
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_HEX
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHARS_HEX
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (AES-256-GCM for PII fields)
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# File uploads (path outside /src)
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=2

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=HRIS Platform <noreply@example.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# SuperAdmin Seed (only used by seedSuperAdmin.js script)
SEED_SUPERADMIN_EMAIL=superadmin@hris.local
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG
SEED_SUPERADMIN_NAME=Root SuperAdmin
