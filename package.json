{
  "name": "hrs_backend",
  "version": "1.0.0",
  "description": "Multi-Tenant SaaS HRS Backend (PERN) - Phase 1",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/scripts/runMigrations.js",
    "migrate:tenants": "node src/scripts/migrateTenants.js",
    "repair:tenant-admins": "node src/scripts/repairTenantAdmins.js",
    "seed:superadmin": "node src/scripts/seedSuperAdmin.js",
    "seed:tenants": "node src/scripts/seedTenants.js",
    "seed:manager": "node src/scripts/seedManagerUser.js",
    "seed:demo": "node src/scripts/seedDemoCorp.js",
    "seed:demo:workflow": "node src/scripts/seedDemoCorpWorkflow.js",
    "seed:demo:roles": "node src/scripts/seedDemoCorpRoles.js",
    "db:reset": "node src/scripts/resetDb.js",
    "db:setup": "npm run db:reset && npm run migrate && npm run seed:superadmin && npm run seed:tenants",
    "test:attendance": "node src/tests/attendance.enterprise.test.js",
    "test:attendance:security": "node src/tests/attendance.approval.security.test.js",
    "test:attendance:settings": "node src/tests/attendance.settings.test.js",
    "test:attendance:cron": "node src/tests/attendance.cron.test.js",
    "test:attendance:settings-rbac": "node src/tests/attendance.settings.rbac.test.js",
    "test:attendance:holidays": "node --test src/tests/holidays.seed.test.js",
    "test:attendance:integrity": "node src/tests/attendance.integrity.test.js",
    "test:attendance:audit": "node src/tests/attendance.production.audit.test.js",
    "test:attendance:holiday-dedup": "node src/tests/holiday.notification.dedup.test.js",
    "repair:attendance-permissions": "node src/scripts/repairAttendancePermissions.js",
    "repair:attendance-records": "node src/scripts/repairAttendanceRecords.js",
    "repair:attendance-records:dry": "node src/scripts/repairAttendanceRecords.js --dry-run",
    "repair:punch-employment-status": "node src/scripts/repairEmploymentStatusForPunch.js",
    "repair:punch-employment-status:dry": "node src/scripts/repairEmploymentStatusForPunch.js"
  },
  "keywords": [
    "pern",
    "multi-tenant",
    "saas",
    "hrs",
    "express",
    "postgres"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "axios": "^1.16.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.2",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.1",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^22.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
